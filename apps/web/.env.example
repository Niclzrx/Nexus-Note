# Supabase project settings (Project Settings → API in the Supabase dashboard).
# The URL and anon key are safe to expose to the browser — Row Level Security
# is what actually protects data, not these values being secret.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key. NEVER prefix this with NEXT_PUBLIC_, never commit a real
# value, never log it. Used server-only (see lib/supabase/admin.ts) for
# account creation during signup and for the dev seed script.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
